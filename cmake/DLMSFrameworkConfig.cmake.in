@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_DLMSFramework_requires_OpenSSL FALSE)
if(NOT DLMSFramework_FIND_COMPONENTS)
  set(_DLMSFramework_requires_OpenSSL TRUE)
endif()
foreach(_DLMSFramework_component IN LISTS DLMSFramework_FIND_COMPONENTS)
  if(_DLMSFramework_component STREQUAL "protocol" OR
     _DLMSFramework_component STREQUAL "cosem_server" OR
     _DLMSFramework_component STREQUAL "runtime" OR
     _DLMSFramework_component STREQUAL "framework")
    set(_DLMSFramework_requires_OpenSSL TRUE)
  endif()
endforeach()

if(_DLMSFramework_requires_OpenSSL)
  find_dependency(OpenSSL)
endif()
unset(_DLMSFramework_requires_OpenSSL)
unset(_DLMSFramework_component)

include("${CMAKE_CURRENT_LIST_DIR}/DLMSFrameworkTargets.cmake")

set(DLMSFramework_SUPPORTED_COMPONENTS
  codec
  io
  protocol
  cosem_server
  runtime
  framework)

foreach(DLMSFramework_component IN LISTS DLMSFramework_FIND_COMPONENTS)
  if(DLMSFramework_component IN_LIST DLMSFramework_SUPPORTED_COMPONENTS AND
     TARGET "dlms::${DLMSFramework_component}")
    set(DLMSFramework_${DLMSFramework_component}_FOUND TRUE)
  else()
    set(DLMSFramework_${DLMSFramework_component}_FOUND FALSE)
  endif()
endforeach()

check_required_components(DLMSFramework)
